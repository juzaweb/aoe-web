datasource db {
  provider = "sqlite"
  // Relative to this schema file: apps/server/database/dev.db
  // The server creates this file + schema on boot when it is missing.
  url      = "file:../database/dev.db"
}

generator client {
  provider = "prisma-client-js"
}

/// Physical naming: every table and column is snake_case (`@@map` / `@map`).
/// TypeScript keeps camelCase field names, so only the database is renamed.
model User {
  id             String   @id
  username       String   @unique
  displayName    String   @map("display_name")
  // Lowercased, diacritic-stripped form of `displayName`. SQLite's lower()
  // only folds ASCII, so uniqueness is enforced on this key instead.
  displayNameKey String   @unique @map("display_name_key")
  passwordHash   String   @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at")
  lastLoginAt    DateTime @default(now()) @updatedAt @map("last_login_at")

  @@map("users")
}

model Player {
  /// Account id (User.id). The stable ownership key for this empire.
  id            String     @id
  /// Display name; can change, so it is never used as an ownership key.
  name          String     @unique
  color         String     @default("#3b82f6")
  wood          Float      @default(300)
  food          Float      @default(300)
  gold          Float      @default(150)
  stone         Float      @default(100)
  population    Int        @default(0)
  populationCap Int        @default(10) @map("population_cap")
  /// Per-unit-type research levels, CSV in UNIT_UPGRADE_ORDER order.
  unitLevels    String     @default("1,1,1,1") @map("unit_levels")
  researchUnitType   String @default("") @map("research_unit_type")
  researchProgressMs Float  @default(0) @map("research_progress_ms")
  researchTimeMs     Float  @default(0) @map("research_time_ms")
  isOnline      Boolean    @default(true) @map("is_online")
  /// Zone the account was last seen in ("kingdom:<id>" or "battlefield").
  lastZone      String     @default("kingdom") @map("last_zone")
  lastSavedAt   DateTime   @default(now()) @updatedAt @map("last_saved_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  buildings     Building[]
  units         Unit[]

  @@map("players")
}

model Building {
  id                   String   @id
  /// Owning account (User.id / Player.id), never a socket session id.
  ownerId              String   @map("owner_id")
  /// Map this building lives on ("kingdom:<id>" or "battlefield").
  zone                 String   @default("world")
  type                 String
  gridX                Int      @map("grid_x")
  gridY                Int      @map("grid_y")
  sizeX                Int      @map("size_x")
  sizeY                Int      @map("size_y")
  hp                   Float
  maxHp                Float    @map("max_hp")
  level                Int      @default(1)
  upgradeProgressMs    Float    @default(0) @map("upgrade_progress_ms")
  upgradeTimeMs        Float    @default(0) @map("upgrade_time_ms")
  isConstructed        Boolean  @default(true) @map("is_constructed")
  constructionProgress Float    @default(100) @map("construction_progress")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  player               Player   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([zone, ownerId])
  @@map("buildings")
}

model Unit {
  id          String   @id
  ownerId     String   @map("owner_id")
  /// Map this unit is currently standing on.
  zone        String   @default("world")
  type        String
  x           Float
  y           Float
  speed       Float
  level       Int      @default(1)
  hp          Float
  maxHp       Float    @map("max_hp")
  actionState String   @default("IDLE") @map("action_state")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  player      Player   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([zone, ownerId])
  @@map("units")
}

model WorldResourceNode {
  id              String   @id
  /// Map this node belongs to. Kingdoms are private; battlefield is shared.
  zone            String   @default("world")
  type            String
  resourceType    String   @map("resource_type")
  gridX           Int      @map("grid_x")
  gridY           Int      @map("grid_y")
  remainingAmount Float    @map("remaining_amount")
  maxAmount       Float    @map("max_amount")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([gridX, gridY])
  @@index([zone])
  @@map("world_resource_nodes")
}

/// Units that committed a cross-map travel and are waiting for the destination
/// room to consume them. The source rows are deleted in the same transaction,
/// so a crash between commit and join cannot duplicate or lose a unit.
model TravelTransfer {
  id              String   @id
  ownerId         String   @map("owner_id")
  fromZone        String   @map("from_zone")
  toZone          String   @map("to_zone")
  sourceSessionId String   @map("source_session_id")
  /// JSON array of TravelUnitSnapshot objects.
  units           String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ownerId, toZone])
  @@map("travel_transfers")
}

/// Bookkeeping for one-off data migrations that must not run twice (for example
/// the kingdom map resize, which resets every kingdom layout).
model SchemaMeta {
  key   String @id
  value String

  @@map("schema_meta")
}

