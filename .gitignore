# Dependencies
node_modules/
.pnpm-store/
.tmp-screens/

# Build artifacts
dist/
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
*.local

# Port the dev game server picked (written by apps/server, read by the client)
.game-server-port

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System and IDE
.DS_Store
Thumbs.db
.idea/
.cache/

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm



# Python bytecode from the asset scripts
__pycache__/
*.pyc

# OpenGameArt pipeline: downloaded archives and extracted frames are large and
# regenerable from scripts/assets/manifest.json. Only the normalised PNGs and
# the lock file belong in the repo.
scripts/.cache/

# Scratch artifacts from the asset pipelines (previews, probes, debug dumps)
scripts/raw_downloads/**/preview_*
scripts/raw_downloads/**/check_*
scripts/raw_downloads/**/zoom_*
scripts/raw_downloads/**/_*
scripts/raw_downloads/**/*_contact.png
scripts/raw_downloads/**/jobs_*.json

# Third-party art packs: archives and extracted frames are large and
# regenerable (scripts/build_oga_walk_sheet.py documents the source URLs);
# only the composited sheets belong in the repo.
scripts/raw_downloads/oga/

# Spike/experiment output (sheets + previews), regenerable from the scripts
scripts/out/
renders/

# Unit-sheet pipeline state: regenerable and not source art
scripts/raw_downloads/**/*_raw_backup.png
scripts/raw_downloads/**/*_ai_backup.png
scripts/raw_downloads/**/*_procedural*.png
scripts/raw_downloads/**/walk_amp_*.png
scripts/raw_downloads/**/walk_anim_*.gif
scripts/raw_downloads/**/walk_anim_*.png
scripts/raw_downloads/**/manifest.json
scripts/raw_downloads/**/audit_report.json
scripts/raw_downloads/**/generation.log
